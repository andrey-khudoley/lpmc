# Зависимости и результат сборки: восстанавливаются из package-lock.json
# и tsconfig, поэтому в истории не нужны.
node_modules/
dist/
dist-test/

# Секреты. Ключей в этом дереве быть не должно вовсе — перечень на случай,
# если кто-то положит их рядом с кодом по невнимательности.
*.key
*.pem
.env

# Развёртывание: реальный инвентарь и переменные с секретами — вне репозитория.
deploy/inventory/hosts.ini
deploy/**/vault.yml
*.vault
storage_state.json

# Артефакты playwright-снимков (визуальная проверка)
.playwright-mcp/

# Генерируется ассемблером из packages/web/design/ (npm run build -w @lpmc/web)
packages/web/public/
